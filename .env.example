# Copia este archivo a .env (NO lo subas a git) y completa los valores reales.
# Se usa con: flutter run --dart-define-from-file=.env
# (también lo lee android/app/build.gradle.kts para el meta-data nativo de
# Google Maps — mismo archivo, una sola fuente de verdad. Ver docs/setup_env.md)
#
# Formato: KEY=VALUE, sin comillas, sin "export", una por línea.

# Supabase — Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase → Authentication → URL Configuration → Redirect URLs. Solo se usa
# si se agrega un flujo de OAuth por navegador (signInWithOAuth); el login
# con Google actual (AuthBloc._onGoogleSignIn) usa el flujo nativo por
# idToken y no lo necesita.
SUPABASE_REDIRECT_URL=

# Google Sign-In — Google Cloud Console → Credentials → "Web client" (debe
# coincidir con el registrado en Supabase → Authentication → Providers →
# Google). Ver AuthBloc._onGoogleSignIn.
GOOGLE_WEB_CLIENT_ID=

# Google Cloud Console → Credentials. Restringir por SHA-1+paquete (Android)
# y por referrer/IP para las llamadas REST (Places/Directions/Geocoding) —
# ver docs/setup_env.md, sección "Restringir la key".
GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend ERP (opcional; vacío = funciones que dependen del ERP, como aceptar
# un viaje, quedan deshabilitadas con un error explícito — ver
# RideRepositoryImpl.acceptRide).
ERP_API_BASE_URL=
